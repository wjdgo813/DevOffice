#!/usr/bin/env node
'use strict';

// DevOffice 내부 도구.
//
// 규칙 (PROTOCOL §9.1): LLM은 판단하고, 이 스크립트는 상태를 다룬다.
// 에이전트가 문서를 손으로 고치는 대신 여기를 통하면 형식이 깨지지 않는다.
//
// 의존성 0 — Node 내장 모듈만 쓴다. npm install 전에도 동작해야 한다.

const P = require('../lib/paths');
const ui = require('../lib/ui');
const state = require('../lib/state');
const journal = require('../lib/journal');
const feature = require('../lib/feature');
const task = require('../lib/task');
const scaffold = require('../lib/scaffold');
const gate = require('../lib/gate');
const doctor = require('../lib/doctor');
const project = require('../lib/project');
const expo = require('../lib/expo');
const impact = require('../lib/impact');

const argv = process.argv.slice(2);

/** --key value 와 --flag 를 분리한다. */
function parse(args) {
  const rest = [];
  const opts = {};
  for (let i = 0; i < args.length; i += 1) {
    const a = args[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const nx = args[i + 1];
      if (nx === undefined || nx.startsWith('--')) opts[key] = true;
      else { opts[key] = nx; i += 1; }
    } else rest.push(a);
  }
  return { rest, opts };
}

function help() {
  ui.header('DevOffice');
  ui.lines([
    'version                  지금 쓰는 버전 (업데이트 확인용)',
    'init                     이 폴더에서 제품을 시작한다',
    'state show               지금 어디까지 왔는지',
    'state get <경로>         값 하나 읽기',
    'state set <경로> <값>    값 하나 쓰기',
    '',
    'feature start <id> --title <제목>',
    'feature show             진행 중인 기능',
    'feature pass <게이트>    게이트 통과 기록',
    'feature verify           사용자 확인 완료 → 잠금 해제',
    'feature cancel           진행 중인 기능 접기 (나중에 다시)',
    'feature impact <ID>      바꾸기 전 — 상태와 영향 범위',
    'feature reopen <ID>      만들어진 기능을 수정하러 다시 열기',
    'feature complete         배포까지 끝. 다음으로',
    '',
    'task add <ID> --owner <담당> --title <내용>',
    'task start|done <ID> [--note ...]',
    'task block <ID> --type <종류> --note <내용>',
    'task resolve <B-001>',
    'task list',
    '',
    'backlog list             만들 기능 목록 (정확한 현재 상태)',
    'gate security            L0 — 되돌릴 수 없는 것 (가장 먼저)',
    'gate spec                명세가 규격에 맞는지',
    'gate plan                계획·준비물이 갖춰졌는지',
    'gate verify              확인 안내에 기대 결과가 있는지',
    'gate all                 위 전부',
    'doctor                   준비물 점검',
    'scaffold <프리셋>        첫 화면·설정 파일 덧씌우기',
    'expo check               폰에 깔 수 있는 SDK 확인 (만들기 전)',
    'expo status              앱이 폰에서 열릴 상태인지 진단',
    '',
    'journal add <종류> <내용>',
    'journal tail [n]',
  ]);
  ui.next('turn', '`devoffice <명령> --help` 로 자세히 볼 수 있어요');
  ui.flush();
}

/**
 * Expo Go 호환성. 만들기 전에 확인하고, 막혔을 때 진단한다.
 * 추측할 필요가 없는 것을 추측하지 않게 하는 것이 목적이다.
 */
async function expoCommand(sub, root) {
  if (sub === 'check' || !sub) {
    const r = await expo.recommend();
    if (!r.ok) {
      ui.header('확인 못 했어요');
      ui.line(r.reason === 'OFFLINE'
        ? '인터넷이 안 되어 폰에 깔리는 버전을 확인하지 못했어요.'
        : '버전 대응표를 해석하지 못했어요.');
      ui.line();
      ui.line('확인 못 한 채로 최신 버전을 쓰면 폰에서 안 열릴 수 있어요.');
      ui.next('turn', '인터넷을 확인하고 다시 시도해주세요');
      return ui.flush(), 1;
    }

    ui.header('폰에 깔 수 있는 버전', `SDK ${r.sdk}`);
    ui.lines([
      `App Store 의 Expo Go   ${r.store.version}`,
      `그래서 써야 할 SDK      ${r.sdk}`,
      r.behind > 0 ? `가장 새 SDK 는 ${r.latestSdk} 이지만 폰에 아직 안 풀렸어요` : '가장 새 SDK 와 같아요',
    ]);
    ui.line();
    ui.line('만들 때 이 명령을 쓰세요');
    ui.line(`  npx create-expo-app@latest . --template blank-typescript@sdk-${r.sdk}`);
    if (r.behind > 0) {
      ui.line();
      ui.line(`⚠️ @latest 로 만들면 SDK ${r.latestSdk} 가 되어 폰에서 열리지 않아요`);
    }
    ui.next('wait', '이 버전으로 만들게요');
    return ui.flush(), 0;
  }

  if (sub === 'status') {
    const [r, alive] = await Promise.all([expo.recommend(), expo.devServerAlive()]);
    const mine = expo.projectSdk(root);

    ui.header('앱 상태 점검');
    ui.item(alive.alive ? '✅' : '❌', `개발 서버  ${alive.alive ? '켜져 있음' : '꺼져 있음'}`);
    ui.item(mine ? '✅' : '⬜', `만든 앱    ${mine ? `SDK ${mine}` : '아직 안 만듦'}`);
    if (r.ok) ui.item('✅', `폰에 깔림  SDK ${r.sdk} (Expo Go ${r.store.version})`);
    else ui.item('⚠️', '폰에 깔림  확인 못 함 (인터넷)');

    const mismatch = r.ok && mine && mine !== r.sdk;
    if (mismatch) {
      ui.line();
      ui.line(`⚠️ 버전이 안 맞아요. 만든 앱은 SDK ${mine}, 폰은 SDK ${r.sdk} 까지만 열려요.`);
      ui.line(`   폰이 아니라 만든 앱을 SDK ${r.sdk} 로 맞춰야 해요.`);
    }
    if (!alive.alive) {
      ui.line();
      ui.line('개발 서버가 꺼져 있어요. 켜기 전에는 폰에서 열리지 않아요.');
    }

    ui.next(mismatch || !alive.alive ? 'wait' : 'go',
      mismatch || !alive.alive ? '고치고 다시 안내할게요' : '폰에서 열어보세요');
    ui.flush();
    return mismatch || !alive.alive ? 1 : 0;
  }

  ui.fail(`'expo ${sub}'는 없는 명령이에요.`, 'check | status');
  return 1;
}

function main() {
  const { rest, opts } = parse(argv);
  const [cmd, sub, ...args] = rest;

  // 지금 실행 중인 것이 어느 버전인지. 업데이트가 먹었는지 확인하는 용도다.
  if (cmd === 'version' || opts.version) {
    const path = require('path');
    let v = '?';
    try {
      v = JSON.parse(require('fs').readFileSync(
        path.join(__dirname, '..', '.claude-plugin', 'plugin.json'), 'utf8')).version;
    } catch (_) { /* 매니페스트가 없으면 알 수 없다 */ }
    ui.header('DevOffice', `v${v}`);
    ui.line(path.join(__dirname, '..').replace(process.env.HOME || '~', '~'));
    ui.next('turn', '이 버전이 아니면 /reload-plugins 를 해보세요');
    return ui.flush();
  }

  if (!cmd || opts.help || cmd === 'help') return help();

  // 프로젝트가 없어도 만들기 전 확인은 가능해야 한다
  if (cmd === 'expo') {
    return expoCommand(sub, P.findRoot() || process.cwd())
      .then((code) => process.exit(code))
      .catch((e) => ui.fail('버전을 확인하지 못했어요.', e.message));
  }

  if (cmd === 'init') {
    const root = process.cwd();
    state.init(root, opts);
    ui.header('제품 상자를 만들었어요');
    ui.line(P.paths(root).base.replace(process.env.HOME || '~', '~'));
    ui.next('turn', '어떤 걸 만들고 싶은지 말씀해주세요');
    return ui.flush();
  }

  // 제품이 없어도 준비물은 볼 수 있어야 한다 (S3 이전에 쓴다)
  if (cmd === 'doctor') return process.exit(doctor.run(P.findRoot(), opts));

  const root = P.requireRoot();

  switch (cmd) {
    case 'state': {
      if (!sub || sub === 'show') return state.summary(root);
      if (sub === 'get') {
        if (!args[0]) ui.fail('어떤 값을 읽을지 알려주세요.', '예: state get product.name');
        return ui.json(state.getPath(state.load(root), args[0]));
      }
      if (sub === 'set') {
        if (args.length < 2) ui.fail('경로와 값이 필요해요.', '예: state set product.name 동네나눔');
        const value = state.coerce(args.slice(1).join(' '));
        state.update(root, (s) => state.setPath(s, args[0], value));
        journal.add(root, 'state.set', args[0], { path: args[0], value });
        return ui.json({ [args[0]]: value });
      }
      return ui.fail(`'state ${sub}'는 없는 명령이에요.`, 'show | get | set');
    }

    case 'feature': {
      if (!sub || sub === 'show') return feature.show(root);
      if (sub === 'start') {
        if (!args[0]) ui.fail('기능 번호가 필요해요.', '예: feature start F-001 --title "물건 목록 보기"');
        if (!opts.title) ui.fail('기능 제목이 필요해요.', '--title "물건 목록 보기"');
        const f = feature.start(root, args[0], opts.title);
        const { created } = scaffold.initFeature(root, f.id, f.title);
        ui.header(f.title, f.id);
        ui.line('시작했어요.');
        if (created.length) ui.line(`서류철을 만들었어요 (${created.join(', ')})`);
        ui.next('wait', '만드는 중이에요');
        return ui.flush();
      }
      if (sub === 'pass') {
        if (!args[0]) ui.fail('어떤 확인인지 알려주세요.', '예: feature pass securityPassed');
        return ui.json(feature.pass(root, args[0]));
      }
      if (sub === 'verify') return feature.verify(root);
      if (sub === 'cancel') return feature.cancel(root, opts.reason);
      if (sub === 'impact') {
        if (!args[0]) ui.fail('어떤 기능인지 알려주세요.', '예: feature impact F-003');
        const r = impact.analyze(root, args[0]);

        ui.header(r.row ? r.row.title : args[0], r.status);
        if (!r.row) {
          ui.line('목록에 없는 기능이에요.');
          ui.next('turn', '기능 번호를 확인해주세요');
          return ui.flush();
        }
        ui.lines([`되돌리기   ${r.reversible}`, `예상 시간   ${r.cost}`]);

        if (r.dependents.length) {
          ui.line();
          ui.line('이것도 같이 바뀌어요');
          r.dependents.forEach((d) => ui.line(` · ${d.title}`));
        } else if (r.depsUnknown) {
          ui.line();
          ui.line('⚠️ 무엇이 같이 바뀌는지 모르는 상태예요');
          ui.line('   기능들 사이의 연결이 기록돼 있지 않아요.');
          ui.line('   "영향 없음"이 아니라 "확인 못 함"입니다 — 직접 살펴보세요.');
        }
        if (r.contract) {
          ui.line();
          ui.line('약속(계약)이 걸려 있어요 — 서버와 화면 양쪽을 같이 고쳐야 해요');
        }
        if (r.live && r.status === impact.STATE.BUILT) {
          ui.line();
          ui.line('⚠️ 실제로 쓰이는 중이에요');
          ui.line('   저장된 데이터를 어떻게 할지 사용자에게 반드시 물어야 해요');
        }
        ui.next('turn', '이대로 바꿀지 사용자에게 확인받으세요');
        return ui.flush();
      }
      if (sub === 'reopen') {
        if (!args[0]) ui.fail('어떤 기능인지 알려주세요.', '예: feature reopen F-003');
        feature.reopen(root, args[0], opts.reason);
        return;
      }
      if (sub === 'complete') {
        feature.complete(root);
        return state.summary(root);
      }
      return ui.fail(`'feature ${sub}'는 없는 명령이에요.`, 'start | show | pass | verify | cancel | complete | impact | reopen');
    }

    case 'backlog': {
      if (sub && sub !== 'list') ui.fail(`'backlog ${sub}'는 없는 명령이에요.`, 'list');
      const b = impact.list(root);
      if (!b.rows.length) {
        ui.header('만들 기능 목록');
        ui.line('아직 정해진 게 없어요.');
        ui.next('turn', '무엇부터 만들지 정해볼까요?');
        return ui.flush();
      }
      const done = b.rows.filter((r) => r.status === 'done').length;
      ui.header('만들 기능 목록', `${done}/${b.rows.length}`);
      const MARK = { done: '✅', in_progress: '🔄', pending: '⬜' };
      b.rows.forEach((r) => {
        const dep = (r.dependsOn || []).length ? `  ←${r.dependsOn.join(',')}` : '';
        const spec = r.spec ? ' ·정해짐' : '';
        ui.item(MARK[r.status] || '⬜', `${r.id}  ${r.title}${spec}${dep}`);
      });
      if (!b.depsRecorded && b.rows.length > 1) {
        ui.line();
        ui.line('⚠️ 기능들 사이의 연결이 기록돼 있지 않아요');
        ui.line('   하나를 빼면 뭐가 같이 무너지는지 알 수 없어요.');
      }
      ui.next('turn', '바꾸실 게 있으면 말씀해주세요');
      return ui.flush();
    }

    case 'task': {
      if (!sub || sub === 'list') return task.list(root);
      if (sub === 'add') {
        if (!args[0]) ui.fail('작업 번호가 필요해요.', '예: task add T1 --owner backend --title "..."');
        if (!opts.title) ui.fail('작업 내용이 필요해요.', '--title "..."');
        return ui.json(task.add(root, args[0], opts));
      }
      if (sub === 'start' || sub === 'done') {
        if (!args[0]) ui.fail('작업 번호가 필요해요.');
        const status = sub === 'start' ? 'in_progress' : 'done';
        return ui.json(task.transition(root, args[0], status, opts));
      }
      if (sub === 'block') {
        if (!args[0]) ui.fail('작업 번호가 필요해요.');
        return task.block(root, args[0], opts);
      }
      if (sub === 'resolve') {
        if (!args[0]) ui.fail('블로커 번호가 필요해요.', '예: task resolve B-001');
        return ui.json(task.resolve(root, args[0]));
      }
      return ui.fail(`'task ${sub}'는 없는 명령이에요.`, 'add | start | done | block | resolve | list');
    }

    case 'gate': {
      const which = sub || 'all';
      return process.exit(gate.run(root, which));
    }

    case 'scaffold': {
      const s = state.load(root);
      const preset = sub || (s.stack && s.stack.client);
      if (!preset) {
        ui.fail('어떤 형태로 만들지 아직 안 정해졌어요.', '먼저 웹인지 앱인지 정해야 해요.');
      }
      const { written, skipped } = project.overlay(root, preset, project.varsFrom(s), opts);
      journal.add(root, 'scaffold', preset, { preset, written: written.length });

      ui.header('첫 화면을 만들었어요', preset);
      written.forEach((f) => ui.item('✅', f));
      if (skipped.length) {
        ui.line();
        ui.line(`이미 있어서 그대로 둔 파일 ${skipped.length}개`);
        ui.line('(덮어쓰려면 --force)');
      }
      ui.next('wait', '이제 인터넷에 올려볼게요');
      return ui.flush();
    }

    case 'journal': {
      if (sub === 'add') {
        if (args.length < 1) ui.fail('기록할 내용이 필요해요.');
        return ui.json(journal.add(root, args[0], args.slice(1).join(' ')));
      }
      if (!sub || sub === 'tail') {
        const n = Number(args[0] || sub === 'tail' ? args[0] : 0) || 20;
        return ui.json(journal.tail(root, n));
      }
      return ui.fail(`'journal ${sub}'는 없는 명령이에요.`, 'add | tail');
    }

    default:
      return ui.fail(`'${cmd}'는 없는 명령이에요.`, 'devoffice --help 로 목록을 볼 수 있어요.');
  }
}

try {
  main();
} catch (err) {
  ui.fail(
    '예상 못 한 문제가 생겼어요.',
    `${err.message}\n              (이 내용을 그대로 알려주시면 고칠 수 있어요)`
  );
}
