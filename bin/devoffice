#!/usr/bin/env node
'use strict';

// DevOffice 내부 도구.
//
// 규칙 (PROTOCOL §9.1): LLM은 판단하고, 이 스크립트는 상태를 다룬다.
// 에이전트가 문서를 손으로 고치는 대신 여기를 통하면 형식이 깨지지 않는다.
//
// 의존성 0 — Node 내장 모듈만 쓴다. npm install 전에도 동작해야 한다.

const P = require('../lib/paths');
const ui = require('../lib/ui');
const state = require('../lib/state');
const journal = require('../lib/journal');
const feature = require('../lib/feature');
const task = require('../lib/task');
const scaffold = require('../lib/scaffold');
const gate = require('../lib/gate');
const doctor = require('../lib/doctor');
const project = require('../lib/project');

const argv = process.argv.slice(2);

/** --key value 와 --flag 를 분리한다. */
function parse(args) {
  const rest = [];
  const opts = {};
  for (let i = 0; i < args.length; i += 1) {
    const a = args[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const nx = args[i + 1];
      if (nx === undefined || nx.startsWith('--')) opts[key] = true;
      else { opts[key] = nx; i += 1; }
    } else rest.push(a);
  }
  return { rest, opts };
}

function help() {
  ui.header('DevOffice');
  ui.lines([
    'init                     이 폴더에서 제품을 시작한다',
    'state show               지금 어디까지 왔는지',
    'state get <경로>         값 하나 읽기',
    'state set <경로> <값>    값 하나 쓰기',
    '',
    'feature start <id> --title <제목>',
    'feature show             진행 중인 기능',
    'feature pass <게이트>    게이트 통과 기록',
    'feature verify           사용자 확인 완료 → 잠금 해제',
    'feature complete         배포까지 끝. 다음으로',
    '',
    'task add <ID> --owner <담당> --title <내용>',
    'task start|done <ID> [--note ...]',
    'task block <ID> --type <종류> --note <내용>',
    'task resolve <B-001>',
    'task list',
    '',
    'gate spec                명세가 규격에 맞는지',
    'gate plan                계획·준비물이 갖춰졌는지',
    'gate verify              확인 안내에 기대 결과가 있는지',
    'gate all                 위 전부',
    'doctor                   준비물 점검',
    'scaffold <프리셋>        첫 화면·설정 파일 덧씌우기',
    '',
    'journal add <종류> <내용>',
    'journal tail [n]',
  ]);
  ui.next('turn', '`devoffice <명령> --help` 로 자세히 볼 수 있어요');
  ui.flush();
}

function main() {
  const { rest, opts } = parse(argv);
  const [cmd, sub, ...args] = rest;

  if (!cmd || opts.help || cmd === 'help') return help();

  if (cmd === 'init') {
    const root = process.cwd();
    state.init(root, opts);
    ui.header('제품 상자를 만들었어요');
    ui.line(P.paths(root).base.replace(process.env.HOME || '~', '~'));
    ui.next('turn', '어떤 걸 만들고 싶은지 말씀해주세요');
    return ui.flush();
  }

  // 제품이 없어도 준비물은 볼 수 있어야 한다 (S3 이전에 쓴다)
  if (cmd === 'doctor') return process.exit(doctor.run(P.findRoot(), opts));

  const root = P.requireRoot();

  switch (cmd) {
    case 'state': {
      if (!sub || sub === 'show') return state.summary(root);
      if (sub === 'get') {
        if (!args[0]) ui.fail('어떤 값을 읽을지 알려주세요.', '예: state get product.name');
        return ui.json(state.getPath(state.load(root), args[0]));
      }
      if (sub === 'set') {
        if (args.length < 2) ui.fail('경로와 값이 필요해요.', '예: state set product.name 동네나눔');
        const value = state.coerce(args.slice(1).join(' '));
        state.update(root, (s) => state.setPath(s, args[0], value));
        journal.add(root, 'state.set', args[0], { path: args[0], value });
        return ui.json({ [args[0]]: value });
      }
      return ui.fail(`'state ${sub}'는 없는 명령이에요.`, 'show | get | set');
    }

    case 'feature': {
      if (!sub || sub === 'show') return feature.show(root);
      if (sub === 'start') {
        if (!args[0]) ui.fail('기능 번호가 필요해요.', '예: feature start F-001 --title "물건 목록 보기"');
        if (!opts.title) ui.fail('기능 제목이 필요해요.', '--title "물건 목록 보기"');
        const f = feature.start(root, args[0], opts.title);
        const { created } = scaffold.initFeature(root, f.id, f.title);
        ui.header(f.title, f.id);
        ui.line('시작했어요.');
        if (created.length) ui.line(`서류철을 만들었어요 (${created.join(', ')})`);
        ui.next('wait', '만드는 중이에요');
        return ui.flush();
      }
      if (sub === 'pass') {
        if (!args[0]) ui.fail('어떤 확인인지 알려주세요.', '예: feature pass securityPassed');
        return ui.json(feature.pass(root, args[0]));
      }
      if (sub === 'verify') return feature.verify(root);
      if (sub === 'complete') {
        feature.complete(root);
        return state.summary(root);
      }
      return ui.fail(`'feature ${sub}'는 없는 명령이에요.`, 'start | show | pass | verify | complete');
    }

    case 'task': {
      if (!sub || sub === 'list') return task.list(root);
      if (sub === 'add') {
        if (!args[0]) ui.fail('작업 번호가 필요해요.', '예: task add T1 --owner backend --title "..."');
        if (!opts.title) ui.fail('작업 내용이 필요해요.', '--title "..."');
        return ui.json(task.add(root, args[0], opts));
      }
      if (sub === 'start' || sub === 'done') {
        if (!args[0]) ui.fail('작업 번호가 필요해요.');
        const status = sub === 'start' ? 'in_progress' : 'done';
        return ui.json(task.transition(root, args[0], status, opts));
      }
      if (sub === 'block') {
        if (!args[0]) ui.fail('작업 번호가 필요해요.');
        return task.block(root, args[0], opts);
      }
      if (sub === 'resolve') {
        if (!args[0]) ui.fail('블로커 번호가 필요해요.', '예: task resolve B-001');
        return ui.json(task.resolve(root, args[0]));
      }
      return ui.fail(`'task ${sub}'는 없는 명령이에요.`, 'add | start | done | block | resolve | list');
    }

    case 'gate': {
      const which = sub || 'all';
      return process.exit(gate.run(root, which));
    }

    case 'scaffold': {
      const s = state.load(root);
      const preset = sub || (s.stack && s.stack.client);
      if (!preset) {
        ui.fail('어떤 형태로 만들지 아직 안 정해졌어요.', '먼저 웹인지 앱인지 정해야 해요.');
      }
      const { written, skipped } = project.overlay(root, preset, project.varsFrom(s), opts);
      journal.add(root, 'scaffold', preset, { preset, written: written.length });

      ui.header('첫 화면을 만들었어요', preset);
      written.forEach((f) => ui.item('✅', f));
      if (skipped.length) {
        ui.line();
        ui.line(`이미 있어서 그대로 둔 파일 ${skipped.length}개`);
        ui.line('(덮어쓰려면 --force)');
      }
      ui.next('wait', '이제 인터넷에 올려볼게요');
      return ui.flush();
    }

    case 'journal': {
      if (sub === 'add') {
        if (args.length < 1) ui.fail('기록할 내용이 필요해요.');
        return ui.json(journal.add(root, args[0], args.slice(1).join(' ')));
      }
      if (!sub || sub === 'tail') {
        const n = Number(args[0] || sub === 'tail' ? args[0] : 0) || 20;
        return ui.json(journal.tail(root, n));
      }
      return ui.fail(`'journal ${sub}'는 없는 명령이에요.`, 'add | tail');
    }

    default:
      return ui.fail(`'${cmd}'는 없는 명령이에요.`, 'devoffice --help 로 목록을 볼 수 있어요.');
  }
}

try {
  main();
} catch (err) {
  ui.fail(
    '예상 못 한 문제가 생겼어요.',
    `${err.message}\n              (이 내용을 그대로 알려주시면 고칠 수 있어요)`
  );
}
