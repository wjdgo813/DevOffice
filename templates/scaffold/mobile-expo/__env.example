# 여기 있는 값들은 "이런 게 필요하다"는 목록일 뿐입니다.
# 실제 값은 .env.local 에 넣습니다. 그 파일은 인터넷에 올라가지 않습니다.
#
# ⚠️ Expo 에서 앱 화면이 읽는 값은 이름이 EXPO_PUBLIC_ 으로 시작해야 합니다.
#    그리고 그 값은 앱 안에 그대로 들어갑니다 — 남이 볼 수 있습니다.
#    비밀번호나 증권사 키처럼 숨겨야 하는 값은 절대 여기 넣지 말고,
#    서버에만 두고 앱은 서버에 물어보게 만듭니다.

# 앱이 이야기할 서버 주소
EXPO_PUBLIC_API_URL=

# Supabase — 공개되어도 되는 값만
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
